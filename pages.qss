/* pages.qss - sidebar, page titles, tables, and dashboard components */
#sidebar {
    background-color: #1e1e1e;
}

#logoLabel {
    color: #f2c200;
    font-size: 16pt;
    font-weight: bold;
    padding: 24px 16px;
}

#navButton {
    background-color: transparent;
    color: #dddddd;
    text-align: left;
    padding: 12px 20px;
    border: none;
    border-radius: 0px;
    font-size: 11pt;
    font-weight: normal;
}

#navButton:hover {
    background-color: #333333;
}

#navButton:checked {
    background-color: #f2c200;
    color: #1e1e1e;
    font-weight: bold;
}

#pageTitle {
    font-size: 20pt;
    font-weight: bold;
}

QCheckBox#dateFilterCheckBox {
    spacing: 8px;
    color: #334155;
    background-color: transparent;
}

QCheckBox#dateFilterCheckBox:hover {
    color: #a16207;
}

QCheckBox#dateFilterCheckBox::indicator {
    width: 13px;
    height: 13px;
    border: 1px solid #94a3b8;
    border-radius: 3px;
    background-color: white;
}

QCheckBox#dateFilterCheckBox::indicator:checked {
    background-color: #eab308;
    border: 1px solid #eab308;
    image: url(checkmark.png);
}

QCheckBox#dateFilterCheckBox:checked {
    color: #18181b;
}

QTableWidget {
    background-color: white;
    alternate-background-color: #fafafa;
    gridline-color: #e0e0e0;
    selection-background-color: #f7e7a0;
    selection-color: #1e1e1e;
}

QHeaderView::section {
    background-color: #1e1e1e;
    color: white;
    padding: 6px;
    border: none;
}

#statCard {
    background-color: white;
    border: 1px solid #dddddd;
    border-radius: 6px;
}

#statValue {
    font-size: 30pt;
    font-weight: bold;
}

#statTitle {
    color: #666666;
    font-size: 11pt;
}

QGroupBox {
    background-color: white;
    border: 1px solid #dddddd;
    border-radius: 6px;
    margin-top: 12px;
    padding: 12px;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 4px;
}

QPushButton#itemActionButton {
    background-color: #f2c200;
    color: #1e1e1e;
    border: none;
    border-radius: 4px;
    min-width: 30px;
    min-height: 30px;
    max-width: 30px;
    max-height: 30px;
    padding: 0px;
    margin: 0px;
    icon-size: 20px;
}

QPushButton#itemActionButton:hover {
    background-color: #ffd633;
}

QPushButton#itemActionButton:pressed {
    background-color: #d9ad00;
}


QLabel#databaseSectionTitle,
QLabel#reportGroupTitle,
QLabel#categorySectionTitle {
    font-weight: bold;
}
