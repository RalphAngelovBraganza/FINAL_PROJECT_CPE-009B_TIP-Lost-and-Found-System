/* styles.qss - shared colors, fonts, and common controls */
QWidget {
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 10pt;
    color: #222222;
}

QMainWindow, QDialog, QStackedWidget {
    background-color: #f5f5f5;
}

QPushButton {
    background-color: #f2c200;
    color: #1e1e1e;
    border: none;
    border-radius: 4px;
    padding: 7px 16px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #ffd633;
}

QPushButton:focus {
    border: 2px solid #8a6d00;
    padding: 5px 14px;
}

QPushButton:pressed {
    background-color: #d9ad00;
}

QPushButton:disabled {
    background-color: #e5e5e5;
    color: #777777;
}

QLineEdit, QTextEdit {
    background-color: white;
    border: 1px solid #bbbbbb;
    border-radius: 4px;
    padding: 5px;
}

QLineEdit:focus, QTextEdit:focus {
    border: 1px solid #f2c200;
}

QComboBox, QDateEdit, QTimeEdit, QDateTimeEdit {
    background-color: white;
    color: #222222;
    border: 1px solid #bbbbbb;
    border-radius: 4px;
    padding: 5px;
    min-height: 20px;
}

QComboBox:focus, QDateEdit:focus, QTimeEdit:focus, QDateTimeEdit:focus {
    border: 1px solid #f2c200;
}

QLineEdit:disabled, QTextEdit:disabled, QComboBox:disabled, QDateEdit:disabled {
    background-color: #eeeeee;
    color: #777777;
    border-color: #d5d5d5;
}
