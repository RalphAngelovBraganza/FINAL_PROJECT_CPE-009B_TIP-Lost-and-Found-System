/* ---------- T.I.P. Lost & Found Login: Light Theme ---------- */
QWidget {
    background-color: #f8fafc;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 14px;
    color: #18181b;
}

/* ---------- Branding ---------- */
#title { font-size: 25px; font-weight: bold; color: #18181b; }
#subtitle { font-size: 12px; color: #64748b; }
#status { font-weight: bold; }

/* ---------- Text boxes ---------- */
QLineEdit {
    background-color: white;
    border: 2px solid #cbd5e1;
    border-radius: 8px;
    padding: 9px;
    min-height: 20px;
}
QLineEdit:hover { border-color: #facc15; }
QLineEdit:focus { border-color: #eab308; }

/* ---------- Buttons ---------- */
QPushButton {
    border: none;
    border-radius: 8px;
    padding: 10px;
    font-weight: bold;
    min-height: 20px;
}
#loginBtn { background-color: #eab308; color: #18181b; }
#loginBtn:hover { background-color: #facc15; }
#loginBtn:pressed { background-color: #ca8a04; }
#loginBtn:disabled { background-color: #facc15; color: #52525b; }
#clearBtn { background-color: #e4e4e7; color: #18181b; }
#clearBtn:hover { background-color: #d4d4d8; }
#clearBtn:pressed { background-color: #a1a1aa; }


/* ---------- Error and success states ---------- */
QLineEdit[error="true"] { border: 2px solid #dc2626; background-color: #fef2f2; }
#status[state="error"] { color: #dc2626; }
#status[state="success"] { color: #16a34a; }

/* ---------- Checkbox ---------- */
QCheckBox { spacing: 8px; color: #334155; background-color: transparent; }
QCheckBox:hover { color: #a16207; }
QCheckBox::indicator {
    width: 13px;
    height: 13px;
    border: 1px solid #94a3b8;
    border-radius: 3px;
    background-color: white;
}
QCheckBox::indicator:checked {
    background-color: #eab308;
    border: 1px solid #eab308;
    image: url(checkmark.png);
}
QCheckBox:checked { color: #18181b; }

/* ---------- Card ---------- */
QFrame#card {
    background-color: white;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 15px;
}
QLabel { background-color: transparent; }
QCheckBox { background-color: transparent; }
