/* dialogs.qss - consistent styling for add, edit, and view dialogs */
QDialog {
    background-color: #f5f5f5;
    color: #222222;
    padding: 12px;
}

QDialog QLabel {
    background-color: transparent;
    color: #222222;
}

QDialog QLineEdit, QDialog QTextEdit, QDialog QComboBox, QDialog QDateEdit {
    background-color: white;
    color: #222222;
    border: 1px solid #d5d5d5;
    border-radius: 4px;
    padding: 6px;
}

QDialog QLineEdit:focus, QDialog QTextEdit:focus, QDialog QComboBox:focus, QDialog QDateEdit:focus {
    border: 1px solid #f2c200;
}

QDialog QTextEdit {
    selection-background-color: #f7e7a0;
    selection-color: #1e1e1e;
}

QDialog QDialogButtonBox QPushButton {
    min-width: 90px;
    padding: 8px 18px;
}

QDialog QDialogButtonBox QPushButton:focus {
    border: 2px solid #8a6d00;
    padding: 6px 16px;
}

QDialog QPushButton:disabled {
    background-color: #e5e5e5;
    color: #777777;
}

QDialog QComboBox, QDialog QDateEdit {
    min-height: 28px;
}

QDialog QLineEdit:disabled, QDialog QTextEdit:disabled, QDialog QComboBox:disabled, QDialog QDateEdit:disabled {
    background-color: #eeeeee;
    color: #777777;
}

#itemDetailValueBox {
    background-color: transparent;
    color: #222222;
    border: none;
    border-radius: 0;
}

/* Form heading hierarchy */
QDialog QLabel#formTitle {
    color: #202020;
    font-size: 20px;
    font-weight: bold;
}

QDialog QLabel#formSubtitle {
    color: #666666;
    font-size: 13px;
    font-weight: normal;
}
